{
  "id": "dialogue-stage",
  "title": "Dialogue Stage",
  "description": "Branching dialogues with portraits, relationships and story variables that later choices can depend on.",
  "version": "3.2.0",
  "authors": [
    {
      "name": "Dialogue Stage"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/dialogue-stage.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "unicanvas",
        "type": "module",
        "compatibility": {
          "minimum": "2.6.0"
        }
      }
    ]
  }
}
