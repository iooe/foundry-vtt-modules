{
  "id": "dialogue-stage",
  "title": "Диалоговая сцена",
  "description": "Кинематографичные ветвящиеся диалоги с последствиями выбора, отношениями и состоянием истории.",
  "version": "3.1.0",
  "authors": [{ "name": "Dialogue Stage" }],
  "compatibility": { "minimum": "13", "verified": "14" },
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/dialogue-stage.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" }
  ],
  "socket": true,
  "relationships": {
    "requires": [
      {
        "id": "unicanvas",
        "type": "module",
        "compatibility": { "minimum": "2.5.0" }
      }
    ]
  }
}
