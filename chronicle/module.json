{
  "id": "chronicle",
  "title": "Chronicle — Timeline Cases",
  "description": "Кооперативное восстановление хронологии событий с последствиями для города, диалогов и расследования.",
  "version": "1.1.0",
  "authors": [
    {
      "name": "Chronicle"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/chronicle.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "socket": true,
