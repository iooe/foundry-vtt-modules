      }
    ],
    "recommends": [
      {
        "id": "city-viewer",
        "type": "module",
        "compatibility": {
          "minimum": "6.1.0"
        }
      },
      {
        "id": "mind-palace",
        "type": "module",
        "compatibility": {
          "minimum": "2.7.0"
        }
      },
      {
        "id": "dialogue-stage",
        "type": "module",
        "compatibility": {
          "minimum": "3.0.0"
        }
      }
    ]
  }
}
